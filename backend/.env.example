# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio (ya esta en .gitignore).

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-o-service-role-key

# --- JWT (genera una clave larga y aleatoria) ---
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXP_MINUTES=120
